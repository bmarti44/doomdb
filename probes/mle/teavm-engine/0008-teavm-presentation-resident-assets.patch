@@ -1043,6 +1043,17 @@ public class WadLoader extends IWadLoader {
 		return this.CacheLumpNum(num, PU_CACHE, patch_t.class);
 	}
 
+	@Override
+	@SuppressWarnings("unchecked")
+	public <T> T GetResidentLump(int num, Class<T> what) {
+		if (num < 0 || num >= lumpcache.length || lumpcache[num] == null)
+			throw new IllegalStateException("unhydrated resident lump");
+		Object value = lumpcache[num];
+		if (!what.isInstance(value))
+			throw new IllegalStateException("resident lump type mismatch");
+		return (T) value;
+	}
+
 	/* (non-Javadoc)
 	 * @see w.IWadLoader#CacheLumpName(java.lang.String, int, java.lang.Class)
 	 */
