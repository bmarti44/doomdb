 		//if (lastrogue==lump)
@@ -1481,6 +1489,28 @@ public class SimpleTextureManager<T, V> implements TextureManager<T> {
 
         return getTextureComposite(tex, col);
     }
+
+    /**
+     * Suspension-free rendering lookup for the retained single-threaded MLE
+     * presentation context. InitTextures has already hydrated both branches.
+     */
+    public final byte[] GetResidentColumn(int tex, int col) {
+        col &= getTexturewidthmask(tex);
+        int lump = getTextureColumnLump(tex, col);
+        int ofs = getTextureColumnOfs(tex, col);
+
+        if (lump > 0) {
+            byte[][] residentPatch = roguePatches.get(lump);
+            if (residentPatch == null)
+                throw new IllegalStateException("unhydrated resident patch");
+            return residentPatch[ofs];
+        }
+
+        byte[][] residentComposite = getTextureComposite(tex);
+        if (residentComposite == null)
+            throw new IllegalStateException("unhydrated resident composite");
+        return residentComposite[col];
+    }
 
