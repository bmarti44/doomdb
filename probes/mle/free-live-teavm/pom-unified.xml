<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>doomdb</groupId>
  <artifactId>free-live-unified-renderer</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-07-27T00:00:00Z</project.build.outputTimestamp>
    <teavm.version>0.15.0</teavm.version>
    <teavm.optimizationLevel>ADVANCED</teavm.optimizationLevel>
    <teavm.minifying>true</teavm.minifying>
    <teavm.sourceMapsGenerated>false</teavm.sourceMapsGenerated>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/target/unified-src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>compile</goal></goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>doomdb.mle.renderer.FreeLiveUnifiedRendererModule</mainClass>
          <targetType>JAVASCRIPT</targetType>
          <jsModuleType>ES2015</jsModuleType>
          <targetDirectory>${project.build.directory}/javascript</targetDirectory>
          <targetFileName>doom-mle-free-live-unified-renderer.js</targetFileName>
          <minifying>${teavm.minifying}</minifying>
          <sourceMapsGenerated>${teavm.sourceMapsGenerated}</sourceMapsGenerated>
          <optimizationLevel>${teavm.optimizationLevel}</optimizationLevel>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
